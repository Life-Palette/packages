{
  "name": "@life-palette/media",
  "version": "0.3.0",
  "description": "Cross-platform media analysis for browser and Expo / React Native: BlurHash, ArtHash, dominant colors, EXIF, and video metadata.",
  "homepage": "https://github.com/Life-Palette/packages/tree/main/packages/media#readme",
  "bugs": "https://github.com/Life-Palette/packages/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Life-Palette/packages",
    "directory": "packages/media"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./react-native": {
      "types": "./dist/react-native.d.mts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.mts",
      "import": "./dist/shared.mjs",
      "require": "./dist/shared.cjs"
    },
    ".": {
      "react-native": {
        "types": "./dist/react-native.d.mts",
        "default": "./dist/react-native.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-arthash-wasm.mjs",
    "dev": "vitest dev",
    "prepublishOnly": "pnpm build && publint --strict",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless"
  },
  "dependencies": {
    "arthash": "^0.5.0",
    "base64-js": "^1.5.1",
    "blurhash": "^2.0.5",
    "metaprobe": "^0.2.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/spark-md5": "^3.0.5",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "attw": "^1.0.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
