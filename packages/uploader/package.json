{
  "name": "@life-palette/uploader",
  "version": "0.2.2",
  "description": "OSS uploader for Life Palette: compress → analyze → multipart upload (concurrent, retryable) → complete. Browser-only, framework-agnostic.",
  "homepage": "https://github.com/Life-Palette/packages/tree/main/packages/uploader#readme",
  "bugs": "https://github.com/Life-Palette/packages/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Life-Palette/packages",
    "directory": "packages/uploader"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "prepublishOnly": "pnpm build && publint --strict",
    "test": "vitest run"
  },
  "dependencies": {
    "@life-palette/media": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "attw": "^1.0.0",
    "browser-image-compression": "^2.0.2",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "browser-image-compression": "^2.0.2"
  },
  "peerDependenciesMeta": {
    "browser-image-compression": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
