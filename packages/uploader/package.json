{
  "name": "@life-palette/uploader",
  "version": "2.0.1",
  "description": "Presigned direct and multipart uploader for Life Palette: resumable sessions, per-part retries, and completion. Browser-only, framework-agnostic.",
  "homepage": "https://github.com/Life-Palette/packages/tree/main/packages/uploader#readme",
  "bugs": "https://github.com/Life-Palette/packages/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Life-Palette/packages",
    "directory": "packages/uploader"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "prepublishOnly": "pnpm build && publint --strict",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@life-palette/media": "workspace:*",
    "browser-image-compression": "^2.0.2"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "attw": "^1.0.0",
    "playwright": "1.63.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
