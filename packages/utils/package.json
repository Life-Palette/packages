{
  "name": "@life-palette/utils",
  "version": "0.2.0",
  "description": "Pure-function toolkit: async helpers, date format, url parse, pagination, markdown strip, browser helpers. Zero dependencies.",
  "homepage": "https://github.com/Life-Palette/packages/tree/main/packages/utils#readme",
  "bugs": "https://github.com/Life-Palette/packages/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Life-Palette/packages",
    "directory": "packages/utils"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "prepublishOnly": "pnpm build && publint --strict && attw --pack .",
    "test": "vitest run",
    "test:browser": "vitest run --browser.headless"
  },
  "devDependencies": {
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "attw": "^1.0.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
