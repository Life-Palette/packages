{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@life-palette/uploader/uniapp/browser": [
        "../../../packages/uploader/src/uniapp/browser.ts"
      ],
      "@life-palette/uploader/uniapp/media": [
        "../../../packages/uploader/src/uniapp/media.ts"
      ],
      "@life-palette/uploader/uniapp": [
        "../../../packages/uploader/src/uniapp/index.ts"
      ],
      "@life-palette/uploader/uniapp/*": [
        "../../../packages/uploader/src/uniapp/*"
      ],
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "shims-uni.d.ts"
  ]
}
