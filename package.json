{
  "name": "life-palette-packages",
  "private": true,
  "description": "拾色(LifePalette) packages monorepo",
  "repository": "https://github.com/Life-Palette/packages",
  "bugs": "https://github.com/Life-Palette/packages/issues",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm --parallel -r run dev",
    "test": "pnpm -r run test",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "play": "pnpm --filter ./apps/playground dev",
    "docs:dev": "pnpm --filter ./apps/docs dev",
    "docs:build": "pnpm --filter ./apps/docs build",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-changelog.js",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.1"
  },
  "packageManager": "pnpm@12.2.1"
}
