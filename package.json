{
  "name": "life-palette-packages",
  "description": "Life Palette packages monorepo",
  "repository": "https://github.com/Life-Palette/packages",
  "bugs": "https://github.com/Life-Palette/packages/issues",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "pnpm --parallel -r run dev",
    "test": "pnpm -r run test",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "play": "pnpm --filter playground dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-changelog.js",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.7.0"
  },
  "packageManager": "pnpm@11.1.1"
}
