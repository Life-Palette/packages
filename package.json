{
  "name": "@life-palette/monorepo",
  "version": "0.0.3",
  "private": true,
  "description": "Life Palette Utils Monorepo",
  "repository": "https://github.com/IceyWu/life-palette-utils",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "pnpm --parallel -r run dev",
    "test": "pnpm -r run test",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "play": "pnpm --filter playground dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "release": "node scripts/pre-release.js && changelogen --release && node scripts/sync-version.js && node scripts/sync-changelog.js && git push --follow-tags && pnpm --filter @life-palette/utils publish",
    "changelog": "changelogen --output CHANGELOG.md",
    "sync-changelog": "node scripts/sync-changelog.js",
    "sync-version": "node scripts/sync-version.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.7.0",
    "changelogen": "^0.6.2",
    "typescript": "^6.0.3",
    "ultracite": "^7.7.0"
  },
  "packageManager": "pnpm@11.1.1"
}
